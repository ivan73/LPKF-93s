[Unit]
Description=gerber2lmd Weboberfläche (LPKF ProtoMat 93S)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@DIR@
Environment=LPKF_PORT=8093
Environment=LPKF_DATA=@DIR@/data
Environment=MPLCONFIGDIR=@DIR@/data/.mpl
ExecStart=/usr/bin/python3 @DIR@/web/app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
